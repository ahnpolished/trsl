# Copy to .env.local and fill in for local dev.

# Required to translate messages. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Vercel KV / Upstash Redis REST credentials (same REST API).
# Without these, storage falls back to a local .data/messages.json file,
# which does NOT work on Vercel's serverless filesystem — set these before
# deploying for real. Add the Vercel KV integration and it fills these in
# automatically, or copy them from an Upstash Redis database's REST API tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=
