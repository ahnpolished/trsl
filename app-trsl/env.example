# Copy to .env.local and fill in for local dev.

# Required to translate messages. Get one at https://platform.openai.com/
OPENAI_API_KEY=

# Required in prod: signs share-id payloads so a hand-crafted /m/<id> URL
# can't bypass the DECLINE guardrail. Any long random string, e.g.
# `openssl rand -base64 32`. Local dev falls back to an insecure built-in
# default if unset — do not rely on that fallback outside local dev.
SHARE_SECRET=
